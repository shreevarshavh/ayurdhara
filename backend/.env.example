# Copy this file to .env and fill in your local PostgreSQL credentials.
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
JWT_SECRET=replace-with-a-long-random-secret
# Optional: absolute path to your Python executable if "python" is not found.
# Example Windows: PYTHON_PATH=C:\Users\YourName\AppData\Local\Programs\Python\Python312\python.exe
PYTHON_PATH=python
